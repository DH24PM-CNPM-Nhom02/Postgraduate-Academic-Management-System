# ===== DEV (copy thành .env). Tất cả đều có mặc định, file này là tùy chọn. =====
COMPOSE_FILE=docker-compose.dev.yml

FRONTEND_PORT=3000
API_GATEWAY_HOST_PORT=8080
MARIADB_PORT=3306

MARIADB_ROOT_PASSWORD=change_root_password
MARIADB_PASSWORD=change_password

JWT_ACCESS_SECRET=replace_with_test_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_test_refresh_secret
JWT_REFRESH_EXPIRES=7d

SEED_ADMIN_PASSWORD=

AUTH_SECRET=
AUTH_TRUST_HOST=true