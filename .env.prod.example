# ===== PROD / SERVER (copy thành .env trên server, KHÔNG commit). =====
COMPOSE_FILE=

# Image đã publish bởi CI
IMAGE_PREFIX=
IMAGE_TAG=

# Bắt buộc, đặt giá trị mạnh và duy nhất
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Origin thật của frontend (dùng cho CORS ở api-gateway)
FRONTEND_ORIGIN=

# Tùy chọn
FRONTEND_PORT=
API_GATEWAY_HOST_PORT=
JWT_ACCESS_EXPIRES=
JWT_REFRESH_EXPIRES=
