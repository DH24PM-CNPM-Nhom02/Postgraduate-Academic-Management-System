# GitHub Container Registry
IMAGE_PREFIX=ghcr.io/dh24pm-cnpm-nhom02/postgraduate-academic-management-system
# Cái này phải vào trong package chọn cái tag mới nhất để dùng
IMAGE_TAG=sha-4659fea


# Ports
FRONTEND_PORT=3000
API_GATEWAY_HOST_PORT=8080

# Database
MARIADB_ROOT_PASSWORD=change_me_test_root
MARIADB_PASSWORD=change_me_test_password

# JWT
JWT_ACCESS_SECRET=replace_with_test_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_test_refresh_secret
JWT_REFRESH_EXPIRES=7d

# Application secrets
AUTH_SECRET=replace_with_test_auth_secret
SEED_ADMIN_PASSWORD=replace_with_test_admin_password
