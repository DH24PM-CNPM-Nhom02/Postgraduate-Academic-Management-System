# ==================================================
# MariaDB Configuration
# ==================================================
MARIADB_ROOT_PASSWORD=your_root_password_here
MARIADB_USER=your_db_user
MARIADB_PASSWORD=your_db_password
MARIADB_HOST=localhost
MARIADB_PORT=3306

# ==================================================
# Database URLs (Prisma) — 1 URL per service
# ==================================================
AUTH_DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/auth_db
PHD_DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/phd_db
DOCUMENT_DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/document_db
NOTIFICATION_DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/notification_db

# ==================================================
# Service Ports
# ==================================================
API_GATEWAY_PORT=
AUTH_SERVICE_PORT=
PHD_SERVICE_PORT=
DOCUMENT_SERVICE_PORT=
NOTIFICATION_SERVICE_PORT=

# ==================================================
# Service Host
# ==================================================
AUTH_SERVICE_HOST=
PHD_SERVICE_HOST=
DOCUMENT_SERVICE_HOST=
NOTIFICATION_SERVICE_HOST=
