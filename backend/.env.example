# ==================================================
# MariaDB Configuration
# ==================================================
MARIADB_ROOT_PASSWORD=rootpassword
MARIADB_USER=pams_user
MARIADB_PASSWORD=pams_password
MARIADB_HOST=localhost
MARIADB_PORT=3306

# ==================================================
# Database URLs (Prisma) — 1 URL per service
# ==================================================
AUTH_DATABASE_URL=mysql://pams_user:pams_password@localhost:3306/auth_db
PHD_DATABASE_URL=mysql://pams_user:pams_password@localhost:3306/phd_db
DOCUMENT_DATABASE_URL=mysql://pams_user:pams_password@localhost:3306/document_db
NOTIFICATION_DATABASE_URL=mysql://pams_user:pams_password@localhost:3306/notification_db

# ==================================================
# Service Ports
# ==================================================
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
PHD_SERVICE_PORT=3002
DOCUMENT_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
