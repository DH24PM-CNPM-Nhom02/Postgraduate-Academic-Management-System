generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum NhomThongBao {
  QUYET_DINH          // Về quyết định
  TIEN_DO             // Tiến độ và học vụ (mốc, phân công GVHD, đổi đề tài)
  NHAC_HAN            // Nhắc hạn
  HE_THONG            // Thông báo hệ thống (Admin gửi)
  CANH_BAO_KY_THUAT   // Lỗi và cảnh báo kỹ thuật (chỉ người cần xử lý)
}

model Notification {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  nhom      NhomThongBao
  loai      String       @db.VarChar(50)
  tieuDe    String       @map("tieu_de") @db.VarChar(200)
  noiDung   String       @map("noi_dung") @db.Text
  duLieu    Json?        @map("du_lieu")
  daDoc     Boolean      @default(false) @map("da_doc")
  readAt    DateTime?    @map("read_at")
  // Chống gửi trùng: service luôn nối thêm userId vào khóa người gửi truyền vào
  khoaTrung String?      @unique @map("khoa_trung") @db.VarChar(191)
  // null = chưa có hạn tự xóa. Cách tính xem notification.policy.ts
  hetHanAt  DateTime?    @map("het_han_at")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId, daDoc, createdAt])
  @@index([hetHanAt])
  @@map("notification")
}