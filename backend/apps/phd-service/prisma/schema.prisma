generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------
enum TrinhDoDauVao {
  THAC_SI
  DAI_HOC
}

enum PhuongThucDaoTao {
  PHUONG_THUC_1
  PHUONG_THUC_2
}

enum GioiTinh {
  NAM
  NU
}

enum TrangThaiHocTap {
  DANG_HOC
  DA_TOT_NGHIEP
  GIA_HAN
  BUOC_THOI_HOC
  /// Bảo lưu / ngừng học: giữ nguyên dữ liệu, khóa tài khoản (không hard delete)
  BAO_LUU
  NGUNG_HOC
}

/// Trạng thái 1 mốc của 1 NCS.
/// LOCKED -> UNLOCKED -> PENDING_REVIEW -> PASSED
///                              \-> REJECTED -> (NCS nộp lại) PENDING_REVIEW
enum TrangThaiMoc {
  LOCKED
  UNLOCKED
  PENDING_REVIEW
  REJECTED
  PASSED
}

/// Trạng thái 1 lần nộp. Lần bị REJECTED giữ nguyên làm lịch sử.
enum TrangThaiMinhChung {
  PENDING_REVIEW
  REJECTED
  PASSED
}

enum LoaiQuyetDinh {
  GIAO_DE_TAI
  PHAN_CONG_GVHD
  THANH_LAP_TIEU_BAN
  CAN_CU_DUYET_MOC
  CONG_NHAN_TOT_NGHIEP
  /// Căn cứ khi đổi trạng thái học tập (nguồn pháp lý cho BAO_LUU / NGUNG_HOC / GIA_HAN)
  GIA_HAN
  BAO_LUU
  NGUNG_HOC
  BUOC_THOI_HOC
  /// Khi NCS BAO_LUU xong quay lại học tiếp
  HOC_TIEP

  KHAC
}

enum TrangThaiQuyetDinh {
  HIEU_LUC
  DEACTIVATE
}

enum HocHamHocVi {
  GIAO_SU
  PHO_GIAO_SU
  TIEN_SI_KHOA_HOC
  TIEN_SI
}

enum VaiTroHuongDan {
  HUONG_DAN_CHINH
  DONG_HUONG_DAN
}

enum TrangThaiPhanCong {
  DANG_HIEU_LUC
  DEACTIVATE
}

enum TrangThaiDeTai {
  HIEU_LUC
  DA_THAY_THE
}

enum LoaiDeNghiDieuChinh {
  DOI_DE_TAI
  DOI_GVHD
  /// Đăng ký gia hạn học tập trực tuyến (SRS 1.2, Điều 5 QĐ 655/QĐ-ĐHAG)
  GIA_HAN
}

enum TrangThaiDeNghi {
  CHO_DUYET
  DA_DUYET
  TU_CHOI
}

enum TrangThaiTotNghiep {
  CHUA_DU_DIEU_KIEN
  DU_DIEU_KIEN
  DA_DUYET
}

enum LoaiDonVi {
  KHOA
  BO_MON
  PHONG_BAN
}

/// Hạn của một mốc được tính từ đâu (xem model MocHan)
enum MocGoc {
  /// Từ ngày nhập học của NCS (nghien_cuu_sinh.ngay_nhap_hoc)
  NGAY_NHAP_HOC
  /// Từ ngày một mốc khác được duyệt đạt (tien_trinh_ncs.passed_at của mốc gocThuTu)
  NGAY_MOC_DAT
  /// Tính từ cuối thời hạn chính quy (hanGiaHan nếu có, không thì hanChinhQuy); số âm = lùi
  HET_HAN_CHINH_QUY
}

enum DonViHan {
  NGAY
  NGAY_LAM_VIEC
  THANG
}
// ----------------------------------------------------------------------------
// 1. HỒ SƠ NCS & CĂN CỨ PHÁP LÝ
// ----------------------------------------------------------------------------
model NghienCuuSinh {
  id                  String           @id @default(uuid())
  /// Liên kết tài khoản đăng nhập (auth-service.users.id) — logic, không FK
  userId              String?          @unique @map("user_id")
  mshv                String           @unique @db.VarChar(20)
  hoTen               String           @map("ho_ten") @db.VarChar(100)
  ngaySinh            DateTime?        @map("ngay_sinh") @db.Date
  gioiTinh            GioiTinh?        @map("gioi_tinh")
  /// LƯU DẠNG CHUỖI (file Excel của trường lưu số nên mất số 0 đầu: 11 chữ số thay vì 12).
  /// 12 chữ số (CCCD) hoặc 9 chữ số (CMND cũ).
  cccd                String?          @unique @db.VarChar(12)
  email               String?          @db.VarChar(100)
  soDienThoai         String?          @unique @map("so_dien_thoai") @db.VarChar(20)
  /// Ngành đào tạo (vd 9620110 — Khoa học cây trồng)
  nganhId             Int?             @map("nganh_id")
  /// Khóa tuyển sinh NCS (vd NCS01) và lớp (vd TSKHCT01) theo sổ của trường
  khoaHoc             String?          @map("khoa_hoc") @db.VarChar(20)
  /// FK đến danh mục khóa NCS sau chuẩn hóa.
  khoaHocId           String?          @map("khoa_hoc_id")
  lop                 String?          @db.VarChar(30)
  ngayNhapHoc         DateTime         @map("ngay_nhap_hoc") @db.Date
  trinhDoDauVao       TrinhDoDauVao    @default(THAC_SI) @map("trinh_do_dau_vao")
  phuongThucDaoTao    PhuongThucDaoTao @default(PHUONG_THUC_2) @map("phuong_thuc_dao_tao")
  /// 3 năm (Thạc sĩ) / 4 năm (Đại học) từ ngày nhập học
  hanChinhQuy         DateTime         @map("han_chinh_quy") @db.Date
  /// 72 tháng từ ngày nhập học (FR1.6)
  hanBuocThoiHoc      DateTime         @map("han_buoc_thoi_hoc") @db.Date
  /// Hạn học tập sau lần gia hạn được duyệt gần nhất; null = chưa gia hạn.
  /// Cập nhật cùng transaction khi duyệt đề nghị loại GIA_HAN. Không vượt hanBuocThoiHoc.
  hanGiaHan           DateTime?        @map("han_gia_han") @db.Date
  trangThai           TrangThaiHocTap  @default(DANG_HOC) @map("trang_thai")
  /// Ngày hiệu lực và lý do của lần đổi trạng thái gần nhất (lịch sử đầy đủ nằm ở audit_log
  /// + QuyetDinh loại BAO_LUU/NGUNG_HOC/GIA_HAN)
  ngayChuyenTrangThai DateTime?        @map("ngay_chuyen_trang_thai") @db.Date
  lyDoChuyenTrangThai String?          @map("ly_do_chuyen_trang_thai") @db.Text
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  nganh        NganhDaoTao?       @relation(fields: [nganhId], references: [id], onDelete: Restrict)
  tienTrinhs   TienTrinhNcs[]
  phanCongs    PhanCongHuongDan[]
  deTais       DeTai[]
  deNghis      DeNghiDieuChinh[]
  quyetDinhs   QuyetDinh[]
  xetTotNghiep XetTotNghiep?
  khoaHocNcs   KhoaHocNcs?        @relation(fields: [khoaHocId], references: [id], onDelete: Restrict)
  khoaHocNcsId String?

  @@index([trangThai])
  @@index([hanChinhQuy])
  @@index([hanBuocThoiHoc])
  @@index([khoaHoc])
  @@map("nghien_cuu_sinh")
}

/// Danh mục khóa tuyển sinh nghiên cứu sinh.
/// Khóa chỉ có mã theo sổ của trường (NCS01, CH12...) nên không lưu tên riêng;
/// cần ghi chú gì thì dùng ghiChu.
model KhoaHocNcs {
  id           String   @id @default(uuid())
  maKhoaHoc    String   @unique @map("ma_khoa_hoc") @db.VarChar(20)
  /// Năm tuyển sinh, để hiển thị cho dễ hiểu khi mã chỉ là NCS01
  namTuyenSinh Int?     @map("nam_tuyen_sinh")
  ghiChu       String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ncss NghienCuuSinh[]

  @@map("khoa_hoc_ncs")
}

/// Danh mục cơ cấu tổ chức của trường.
model DonVi {
  id        String    @id @default(uuid())
  ten       String    @db.VarChar(255)
  loai      LoaiDonVi
  parentId  String?   @map("parent_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  /// Đơn vị cha; null nếu là đơn vị cấp cao nhất.
  parent DonVi? @relation("DonViHierarchy", fields: [parentId], references: [id], onDelete: Restrict)

  /// Các đơn vị trực thuộc.
  children DonVi[] @relation("DonViHierarchy")

  /// Giảng viên có đơn vị công tác được chuẩn hóa về đơn vị này.
  giangViens GiangVienHuongDan[]

  @@index([parentId])
  @@index([ten, loai])
  @@map("don_vi")
}

/// Danh mục ngành đào tạo tiến sĩ (import Excel upsert theo maNganh).
model NganhDaoTao {
  id        Int      @id @default(autoincrement())
  /// Mã ngành theo danh mục của Bộ (vd 9620110)
  maNganh   String   @unique @map("ma_nganh") @db.VarChar(20)
  tenNganh  String   @map("ten_nganh") @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ncss NghienCuuSinh[]

  @@map("nganh_dao_tao")
}

/// Nguồn pháp lý (FR1.5): số/ngày quyết định, biên bản làm căn cứ để duyệt.
/// Không bao giờ xóa — vô hiệu hóa bằng trạng thái.
model QuyetDinh {
  id            String             @id @default(uuid())
  ncsId         String?            @map("ncs_id")
  loai          LoaiQuyetDinh
  soQuyetDinh   String             @map("so_quyet_dinh") @db.VarChar(50)
  ngayQuyetDinh DateTime           @map("ngay_quyet_dinh") @db.Date
  /// File scan (document-service)
  fileId        String?            @map("file_id")
  trangThai     TrangThaiQuyetDinh @default(HIEU_LUC) @map("trang_thai")
  ghiChu        String?            @db.Text
  nguoiTaoId    String             @map("nguoi_tao_id")
  createdAt     DateTime           @default(now()) @map("created_at")

  ncs        NghienCuuSinh?     @relation(fields: [ncsId], references: [id], onDelete: Restrict)
  minhChungs MinhChungMoc[]
  phanCongs  PhanCongHuongDan[]
  deTais     DeTai[]
  deNghis    DeNghiDieuChinh[]
  totNghieps XetTotNghiep[]

  @@unique([loai, soQuyetDinh, ncsId])
  @@index([loai, soQuyetDinh])
  @@index([ncsId])
  @@map("quyet_dinh")
}

// ----------------------------------------------------------------------------
// 2. TIẾN TRÌNH 9 MỐC (BR-08)
// ----------------------------------------------------------------------------
model MocTienTrinh {
  id         Int     @id @default(autoincrement())
  thuTu      Int     @unique @map("thu_tu")
  tenMoc     String  @map("ten_moc") @db.VarChar(150)
  moTa       String? @map("mo_ta") @db.Text
  /// true cho mốc 2 (tiểu luận tổng quan), 4 (chuyên đề 1), 5 (chuyên đề 2)
  yeuCauDiem Boolean @default(false) @map("yeu_cau_diem")

  tienTrinhs TienTrinhNcs[]
  hans       MocHan[]

  @@map("moc_tien_trinh")
}

/// Trạng thái từng mốc của từng NCS — nguồn sự thật cho BR-08.
/// Tạo sẵn 9 dòng khi tạo NCS: mốc 1 = PASSED, mốc 2 = UNLOCKED, mốc 3..9 = LOCKED.
model TienTrinhNcs {
  id          String       @id @default(uuid())
  ncsId       String       @map("ncs_id")
  mocId       Int          @map("moc_id")
  trangThai   TrangThaiMoc @default(LOCKED) @map("trang_thai")
  openedAt    DateTime?    @map("opened_at")
  submittedAt DateTime?    @map("submitted_at")
  passedAt    DateTime?    @map("passed_at")
  /// Hạn theo Kế hoạch học tập và nghiên cứu toàn khóa đã phê duyệt (Giáo vụ nhập, có thể để trống).
  /// Dùng để nhắc; phải <= hạn cứng của mốc (xem MocHan) và <= hanBuocThoiHoc.
  hanKeHoach  DateTime?    @map("han_ke_hoach") @db.Date
  /// Optimistic lock: tăng mỗi lần đổi trạng thái (chống duyệt trùng/đồng thời)
  version     Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  ncs        NghienCuuSinh  @relation(fields: [ncsId], references: [id], onDelete: Restrict)
  moc        MocTienTrinh   @relation(fields: [mocId], references: [id], onDelete: Restrict)
  minhChungs MinhChungMoc[]

  @@unique([ncsId, mocId])
  @@index([trangThai])
  @@map("tien_trinh_ncs")
}

/// Cấu hình hạn theo quy định của trường. Một mốc có thể có nhiều hạn.
/// Hạn của từng NCS KHÔNG lưu cứng: tính khi truy vấn từ ngày gốc + soDonVi (xem han.service.ts).
model MocHan {
  id         Int      @id @default(autoincrement())
  mocId      Int      @map("moc_id")
  /// Mã ngắn để seed upsert, vd NOP_MINH_CHUNG, DANG_KY_CHUYEN_DE
  maHan      String   @map("ma_han") @db.VarChar(50)
  tenHan     String   @map("ten_han") @db.VarChar(200)
  mocGoc     MocGoc   @map("moc_goc")
  /// Chỉ dùng khi mocGoc = NGAY_MOC_DAT: thứ tự mốc làm gốc (vd 8)
  gocThuTu   Int?     @map("goc_thu_tu")
  /// Số âm = lùi (vd -3 THANG so với hết hạn chính quy)
  soDonVi    Int      @map("so_don_vi")
  donVi      DonViHan @map("don_vi")
  /// true = hạn ước tính/tham khảo, chỉ để nhắc, không dùng làm hạn cứng
  laHanMem   Boolean  @default(false) @map("la_han_mem")
  /// Căn cứ trong quy định, để Giáo vụ đối chiếu
  canCu      String?  @map("can_cu") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  moc MocTienTrinh @relation(fields: [mocId], references: [id], onDelete: Restrict)

  @@unique([mocId, maHan])
  @@map("moc_han")
}

/// Mỗi lần nộp = 1 dòng. Bị từ chối -> NCS nộp lại = dòng mới (lanNop + 1).
model MinhChungMoc {
  id            String             @id @default(uuid())
  tienTrinhId   String             @map("tien_trinh_id")
  lanNop        Int                @default(1) @map("lan_nop")
  /// document-service.documents.id (PDF <= 15MB)
  fileId        String             @map("file_id")
  ghiChuNcs     String?            @map("ghi_chu_ncs") @db.Text
  trangThai     TrangThaiMinhChung @default(PENDING_REVIEW) @map("trang_thai")
  /// Trung bình các phiếu nhận xét (chỉ mốc yeuCauDiem)
  diemTrungBinh Decimal?           @map("diem_trung_binh") @db.Decimal(4, 2)
  lyDoTuChoi    String?            @map("ly_do_tu_choi") @db.Text
  /// Căn cứ pháp lý Giáo vụ dựa vào khi duyệt
  quyetDinhId   String?            @map("quyet_dinh_id")
  nguoiDuyetId  String?            @map("nguoi_duyet_id")
  ngayNop       DateTime           @default(now()) @map("ngay_nop")
  ngayDuyet     DateTime?          @map("ngay_duyet")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tienTrinh     TienTrinhNcs   @relation(fields: [tienTrinhId], references: [id], onDelete: Restrict)
  quyetDinh     QuyetDinh?     @relation(fields: [quyetDinhId], references: [id], onDelete: Restrict)
  phieuNhanXets PhieuNhanXet[]

  @@unique([tienTrinhId, lanNop])
  @@index([trangThai])
  @@map("minh_chung_moc")
}

/// Phiếu nhận xét online. Người chấm nằm NGOÀI hệ thống; Giáo vụ nhập thay
/// (nhapBoiId). Lưu vĩnh viễn, không sửa/xóa.
model PhieuNhanXet {
  id             String   @id @default(uuid())
  minhChungId    String   @map("minh_chung_id")
  tenNguoiCham   String   @map("ten_nguoi_cham") @db.VarChar(150)
  donViNguoiCham String?  @map("don_vi_nguoi_cham") @db.VarChar(255)
  /// Thang 10, lẻ 1 chữ số thập phân
  diem           Decimal  @db.Decimal(3, 1)
  nhanXet        String?  @db.Text
  nhapBoiId      String   @map("nhap_boi_id")
  createdAt      DateTime @default(now()) @map("created_at")

  minhChung MinhChungMoc @relation(fields: [minhChungId], references: [id], onDelete: Restrict)

  @@index([minhChungId])
  @@map("phieu_nhan_xet")
}

// ----------------------------------------------------------------------------
// 3. GVHD & ĐỊNH MỨC (FR3.x, BR-09)
// ----------------------------------------------------------------------------
model GiangVienHuongDan {
  id               String      @id @default(uuid())
  /// Chỉ điền nếu GVHD có tài khoản đăng nhập
  userId           String?     @unique @map("user_id")
  /// Số hiệu công chức (shcc) của giảng viên trong trường; null với GVHD ngoài trường.
  /// Khóa nghiệp vụ để import/upsert từ sheet GIANGVIEN.
  maGv             String?     @unique @map("ma_gv") @db.VarChar(20)
  hoTen            String      @map("ho_ten") @db.VarChar(100)
  gioiTinh         GioiTinh?   @map("gioi_tinh")
  ngaySinh         DateTime?   @map("ngay_sinh") @db.Date
  email            String?     @db.VarChar(100)
  hocHamHocVi      HocHamHocVi @map("hoc_ham_hoc_vi")
  /// Ngành/chuyên ngành đào tạo tiến sĩ của GVHD (t_cmdtao)
  chuyenNganh      String?     @map("chuyen_nganh") @db.VarChar(255)
  /// Nước cấp bằng tiến sĩ (ten_qg)
  quocGiaTotNghiep String?     @map("quoc_gia_tot_nghiep") @db.VarChar(50)
  /// Đơn vị công tác đã chuẩn hóa.
  donViId          String?     @map("don_vi_id")

  /// FR3.1: lịch sử công bố 5 năm gần nhất (JSON)
  lichSuCongBo5Nam  Json?    @map("lich_su_cong_bo_5_nam")
  /// GS=7, PGS=5, TS=3 (BR-09)
  maxNcsChoPhep     Int      @map("max_ncs_cho_phep")
  /// Cache số NCS đang HD (độc lập 1.0, đồng HD 0.5
  soNcsDangHuongDan Decimal  @default(0.0) @map("so_ncs_dang_huong_dan") @db.Decimal(3, 1)
  trangThai         Boolean  @default(true) @map("trang_thai")
  /// Optimistic lock chống 2 request cùng vượt định mức
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  phanCongs PhanCongHuongDan[]
  deNghis   DeNghiDieuChinh[]  @relation("DeNghiGvhdMoi")
  donVi     DonVi?             @relation(fields: [donViId], references: [id], onDelete: Restrict)

  @@index([donViId])
  @@map("giang_vien_huong_dan")
}

model PhanCongHuongDan {
  id          String            @id @default(uuid())
  ncsId       String            @map("ncs_id")
  gvhdId      String            @map("gvhd_id")
  vaiTro      VaiTroHuongDan    @default(HUONG_DAN_CHINH) @map("vai_tro")
  /// 1.0 = độc lập, 0.5 = đồng hướng dẫn
  trongSo     Decimal           @default(1.0) @map("trong_so") @db.Decimal(2, 1)
  quyetDinhId String            @map("quyet_dinh_id")
  trangThai   TrangThaiPhanCong @default(DANG_HIEU_LUC) @map("trang_thai")
  /// Hiệu lực theo quyết định phân công; ngayKetThuc điền khi bị thay thế (DEACTIVATE)
  ngayBatDau  DateTime?         @map("ngay_bat_dau") @db.Date
  ngayKetThuc DateTime?         @map("ngay_ket_thuc") @db.Date
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  ncs       NghienCuuSinh     @relation(fields: [ncsId], references: [id], onDelete: Restrict)
  gvhd      GiangVienHuongDan @relation(fields: [gvhdId], references: [id], onDelete: Restrict)
  quyetDinh QuyetDinh         @relation(fields: [quyetDinhId], references: [id], onDelete: Restrict)
  deNghis   DeNghiDieuChinh[] @relation("DeNghiPhanCongCu")

  @@index([ncsId, trangThai])
  @@index([gvhdId, trangThai])
  @@map("phan_cong_huong_dan")
}

// ----------------------------------------------------------------------------
// 4. ĐỀ TÀI & ĐỀ NGHỊ THAY ĐỔI (UC-PHD-06/07)
// ----------------------------------------------------------------------------
model DeTai {
  id          String         @id @default(uuid())
  ncsId       String         @map("ncs_id")
  tenDeTai    String         @map("ten_de_tai") @db.VarChar(500)
  trangThai   TrangThaiDeTai @default(HIEU_LUC) @map("trang_thai")
  quyetDinhId String?        @map("quyet_dinh_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  ncs       NghienCuuSinh @relation(fields: [ncsId], references: [id], onDelete: Restrict)
  quyetDinh QuyetDinh?    @relation(fields: [quyetDinhId], references: [id], onDelete: Restrict)

  @@index([ncsId, trangThai])
  @@map("de_tai")
}

/// Duyệt DOI_DE_TAI : đóng đề tài cũ (DA_THAY_THE) + tạo đề tài mới.
/// Duyệt DOI_GVHD   : đóng phân công cũ + tạo phân công mới (kiểm định mức)
///                    + lưu quyết định + audit — trong 1 transaction.
/// Duyệt GIA_HAN    : cập nhật nghien_cuu_sinh.han_gia_han = hanMoiDeNghi (<= hanBuocThoiHoc)
///                    + đổi trạng thái GIA_HAN + lưu quyết định + audit.
model DeNghiDieuChinh {
  id            String              @id @default(uuid())
  ncsId         String              @map("ncs_id")
  loai          LoaiDeNghiDieuChinh
  lyDo          String              @map("ly_do") @db.Text
  /// DOI_DE_TAI
  tenDeTaiMoi   String?             @map("ten_de_tai_moi") @db.VarChar(500)
  /// GIA_HAN: hạn học tập mới đề nghị
  hanMoiDeNghi  DateTime?           @map("han_moi_de_nghi") @db.Date
  /// DOI_GVHD: phân công bị thay và GVHD mới
  phanCongCuId  String?             @map("phan_cong_cu_id")
  gvhdMoiId     String?             @map("gvhd_moi_id")
  nguoiDeNghiId String              @map("nguoi_de_nghi_id")
  trangThai     TrangThaiDeNghi     @default(CHO_DUYET) @map("trang_thai")
  lyDoTuChoi    String?             @map("ly_do_tu_choi") @db.Text
  nguoiDuyetId  String?             @map("nguoi_duyet_id")
  ngayDuyet     DateTime?           @map("ngay_duyet")
  /// Quyết định mới sau khi duyệt
  quyetDinhId   String?             @map("quyet_dinh_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  ncs        NghienCuuSinh      @relation(fields: [ncsId], references: [id], onDelete: Restrict)
  quyetDinh  QuyetDinh?         @relation(fields: [quyetDinhId], references: [id], onDelete: Restrict)
  phanCongCu PhanCongHuongDan?  @relation("DeNghiPhanCongCu", fields: [phanCongCuId], references: [id], onDelete: Restrict)
  gvhdMoi    GiangVienHuongDan? @relation("DeNghiGvhdMoi", fields: [gvhdMoiId], references: [id], onDelete: Restrict)

  @@index([ncsId, trangThai])
  @@map("de_nghi_dieu_chinh")
}

// ----------------------------------------------------------------------------
// 5. XÉT TỐT NGHIỆP TỰ ĐỘNG (UC-PHD-12)
// ----------------------------------------------------------------------------
/// da9Moc tính từ tien_trinh_ncs. Ngoại ngữ/công nợ lấy từ phân hệ khác hoặc
/// mock (nguonDuLieu) — lưu snapshot lúc kiểm tra.
model XetTotNghiep {
  id                   String             @id @default(uuid())
  ncsId                String             @unique @map("ncs_id")
  da9Moc               Boolean            @default(false) @map("da_9_moc")
  datNgoaiNgu          Boolean            @default(false) @map("dat_ngoai_ngu")
  /// Chuẩn đầu ra ngoại ngữ đã được công nhận (CHUAN_DAU_RA_TA) và ngày công nhận
  chuanDauRaNgoaiNgu   String?            @map("chuan_dau_ra_ngoai_ngu") @db.VarChar(100)
  ngayCongNhanNgoaiNgu DateTime?          @map("ngay_cong_nhan_ngoai_ngu") @db.Date
  khongConCongNo       Boolean            @default(false) @map("khong_con_cong_no")
  /// MOCK | API — nguồn dữ liệu ngoại ngữ/công nợ
  nguonDuLieu          String?            @map("nguon_du_lieu") @db.VarChar(20)
  kiemTraLuc           DateTime?          @map("kiem_tra_luc")
  trangThai            TrangThaiTotNghiep @default(CHUA_DU_DIEU_KIEN) @map("trang_thai")
  nguoiDuyetId         String?            @map("nguoi_duyet_id")
  ngayDuyet            DateTime?          @map("ngay_duyet")
  /// Ngày hiệu lực công nhận tốt nghiệp theo quyết định (khác ngày Giáo vụ bấm duyệt)
  ngayTotNghiep        DateTime?          @map("ngay_tot_nghiep") @db.Date
  quyetDinhId          String?            @map("quyet_dinh_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  ncs       NghienCuuSinh @relation(fields: [ncsId], references: [id], onDelete: Restrict)
  quyetDinh QuyetDinh?    @relation(fields: [quyetDinhId], references: [id], onDelete: Restrict)

  @@map("xet_tot_nghiep")
}

// ----------------------------------------------------------------------------
// 6. AUDIT TRAIL (SRS 4.2) — append-only, ghi cùng transaction nghiệp vụ
// ----------------------------------------------------------------------------
model AuditLog {
  id            String   @id @default(uuid())
  actorId       String   @map("actor_id")
  action        String   @db.VarChar(100)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String   @map("entity_id")
  ncsId         String?  @map("ncs_id")
  oldValue      Json?    @map("old_value")
  newValue      Json?    @map("new_value")
  clientIp      String?  @map("client_ip") @db.VarChar(45)
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([ncsId])
  @@index([createdAt])
  @@map("audit_log")
}
